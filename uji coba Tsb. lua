local AIMLOCK_URL = "https://raw.githubusercontent.com/NandazorxHub/https-github.com-NandazorxHub-ZorxHub/refs/heads/main/aimlock.lua"
local AIMLOCK_GUI_NAME = "NzkAimlock"

local function findAimlockGui()
	return game.CoreGui:FindFirstChild(AIMLOCK_GUI_NAME)
end

local function clearAllOutlines()
	-- hapus semua Highlight bernama ZorxOutline di semua karakter
	for _, p in pairs(Players:GetPlayers()) do
		if p.Character then
			for _, child in pairs(p.Character:GetChildren()) do
				if child:IsA("Highlight") and child.Name == "ZorxOutline" then
					child:Destroy()
				end
			end
		end
	end
end

local function aimlockForceStop()
	-- 1. Panggil _G.ZorxAimlockOff kalau ada (dari script aimlock yang udah di-update)
	if _G.ZorxAimlockOff then
		pcall(_G.ZorxAimlockOff)
	end

	-- 2. Destroy GUI aimlock di pojok kanan atas
	local gui = findAimlockGui()
	if gui then
		gui:Destroy()
	end

	-- 3. Bersihin semua outline yang mungkin masih nempel
	clearAllOutlines()

	-- 4. Reset posisi kamera supaya ga ngunci lagi
	pcall(function()
		workspace.CurrentCamera.CameraType = Enum.CameraType.Custom
	end)

	-- 5. Bersihin semua _G yang nyangkut
	_G.ZorxAimlockOn = nil
	_G.ZorxAimlockOff = nil
	_G.ZorxAimlockStatus = nil
end

local function aimlockStart()
	-- load ulang script aimlock dari GitHub (fresh, tanpa sisa)
	local gui = findAimlockGui()
	if gui then
		-- kalau masih ada, destroy dulu biar fresh
		gui:Destroy()
	end
	clearAllOutlines()

	loadstring(game:HttpGet(AIMLOCK_URL))()

	-- tunggu script init
	task.wait(0.5)
end
